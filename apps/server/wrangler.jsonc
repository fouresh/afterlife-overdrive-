{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker: static client + /api + Durable Objects + D1.
  // database_id placeholders are replaced in CI by scripts/cf-deploy.mjs (creates the DB if missing).
  "name": "afterlife-overdrive",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "ENVIRONMENT": "production" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterlife-overdrive",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // Preview Worker for branches/PRs (separate data). Workers with Durable Objects cannot use
    // Cloudflare "preview URLs", so previews are a second Worker with its own D1 database.
    "preview": {
      "name": "afterlife-overdrive-preview",
      "vars": { "ENVIRONMENT": "preview" },
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "afterlife-overdrive-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
